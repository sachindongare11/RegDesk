# Copy to .env and adjust for local overrides. docker-compose.yml sets the
# container-network values (service names as hostnames) directly; this file
# matters when running a service outside Docker, straight on your laptop.

# --- mcp-tools ---
MCP_TOOLS_QDRANT_URL=http://localhost:6333
MCP_TOOLS_QDRANT_COLLECTION=regdesk_regulations
MCP_TOOLS_OLLAMA_BASE_URL=http://localhost:11434
MCP_TOOLS_OLLAMA_EMBED_MODEL=nomic-embed-text
MCP_TOOLS_DENSE_VECTOR_SIZE=768

# --- agent-api ---
AGENT_API_MCP_TOOLS_URL=http://localhost:8000/mcp
AGENT_API_OLLAMA_BASE_URL=http://localhost:11434
AGENT_API_OLLAMA_MODEL=qwen2.5:3b

# --- ingest-worker ---
INGEST_WORKER_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
INGEST_WORKER_QUEUE_NAME=regdesk.ingest
INGEST_WORKER_QDRANT_URL=http://localhost:6333
INGEST_WORKER_QDRANT_COLLECTION=regdesk_regulations
INGEST_WORKER_OLLAMA_BASE_URL=http://localhost:11434
INGEST_WORKER_OLLAMA_EMBED_MODEL=nomic-embed-text
INGEST_WORKER_DENSE_VECTOR_SIZE=768
INGEST_WORKER_CORPUS_DIR=./data/regulations

# --- scripts/ingest_corpus.py ---
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
